        "type": "float",
        "required": false
      }
    },
    "motif": {
      "enabled": {
        "type": "bool",
        "required": false
      },
      "flank": {
        "type": "int",
        "required": false
      },
      "min_fibers": {
        "type": "int",
        "required": false
      },
      "pwm_threshold": {
        "type": "float",
        "required": false
      }
    },
    "footprint": {
      "enabled": {
        "type": "bool",
        "required": false
      },
      "flank": {
        "type": "int",
        "required": false
      }
    },
    "nucpos": {
      "enabled": {
        "type": "bool",
        "required": false
      },
      "upstream_nucs": {
        "type": "int",
        "required": false
      },
      "downstream_nucs": {
