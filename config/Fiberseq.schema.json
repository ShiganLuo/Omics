        "required": false
      },
      "image_formats": {
        "type": "list",
        "required": false
      },
      "genes": {
        "type": "list",
        "required": false
      },
      "exp_specific": {
        "vep_cache": {
          "type": "str",
          "required": true,
          "path": "dir"
        },
        "species": {
          "type": "str",
          "required": true
        },
        "assembly": {
          "type": "str",
          "required": true
        },
        "dist": {
          "type": "int",
          "required": true
        }
      },
      "circos": {
        "genome": {
          "type": "str",
          "required": true
        },
        "cytoband": {
          "type": "str",
          "required": false
        },
        "ins_bin_size": {
          "type": "int",
          "required": true
        }
      },
      "oncoprint": {
        "cosmic_file": {
          "type": "str",
          "required": false,
          "path": "file"
        },
        "deseq2_files": {
          "type": "dict",
          "required": false
        }
      },
      "diff_analysis": {
        "large_sv_threshold": {
          "type": "int",
          "required": true
        }
      },
      "gene_model": {
        "threads": {
          "type": "int",
          "required": true
        }
      },
      "mei": {
        "type": "dict",
        "required": false,
        "properties": {
          "enabled": {
            "type": "bool",
            "required": false,
            "default": true,
            "description": "Gate the sv_mei analysis (MEI classification + figure suite)."
          },
          "min_len": {
            "type": "int",
            "required": false,
            "default": 100,
            "description": "Minimum inserted-sequence length (bp) sent to RepeatMasker; shorter events stay 'short_unclassified'."
          },
          "full_length": {
            "type": "int",
            "required": false,
            "default": 6000,
            "description": "Minimum insertion length (bp) for full-length candidacy."
          },
          "full_length_family": {
            "type": "str",
            "required": false,
            "default": "L1",
            "description": "Bucket name considered for full-length candidacy (L1 by default; e.g. an ERVK bucket for other clades)."
          },
