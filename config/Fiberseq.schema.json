        "type": "bool",
        "required": false
      },
      "min_fibers": {
        "type": "int",
        "required": false
      }
    },
    "diff": {
      "enabled": {
        "type": "bool",
        "required": false
      },
      "alpha": {
        "type": "float",
        "required": false
      },
      "design_tsv": {
        "type": "str",
        "nullable": true,
        "required": false
      },
      "annot_sample": {
        "type": "str",
        "nullable": true,
        "required": false
      }
    },
    "coactuation": {
      "enabled": {
        "type": "bool",
        "required": false
      },
      "max_distance": {
