{
  "indir": {
    "type": "str",
    "required": true
  },
  "outdir": {
    "type": "str",
    "required": true
  },
  "logdir": {
    "type": "str",
    "required": true
  },
  "samples": {
    "type": "list",
    "required": true
  },
  "Procedure": {
    "pbmm2": {
      "type": "null",
      "nullable": true,
      "required": false
    },
    "samtools": {
      "type": "null",
      "nullable": true,
      "required": false
    },
    "deepvariant": {
      "type": "null",
      "nullable": true,
      "required": false
    },
    "gatk": {
      "type": "null",
      "nullable": true,
      "required": false
    },
    "pbsv": {
      "type": "null",
      "nullable": true,
      "required": false
    },
    "bgzip": {
      "type": "null",
      "nullable": true,
      "required": false
    },
    "tabix": {
      "type": "null",
      "nullable": true,
      "required": false
    },
    "bcftools": {
      "type": "null",
      "nullable": true,
      "required": false
    },
    "hiphase": {
      "type": "null",
      "nullable": true,
      "required": false
    },
    "trgt": {
      "type": "null",
      "nullable": true,
      "required": false
    },
    "decoil": {
      "type": "null",
      "nullable": true,
      "required": false
    }
  },
  "Params": {
    "regionplot": {
      "enabled": {
        "type": "bool",
        "required": false,
        "default": false,
        "description": "Gate for the regionplot module (multi-sample track stacking plots over user regions, consumes this workflow's bigwigs)."
      },
      "regions": {
        "type": "str",
        "required": false,
        "default": null,
        "description": "Regions file, required when enabled. Auto-detected per row: BED rows (chrom<TAB>start<TAB>end[<TAB>name], col4 names the panel) or list lines ([NAME=]chrom:start-end, the same string pyGenomeTracks --region consumes; NAME= names the panel, else chrom_start_end). Formats may be mixed; #/track/browser lines skipped."
      },
      "sample_group_dict": {
        "type": "dict",
        "required": false,
        "default": {},
        "description": "sample_id -> biological group for track coloring; auto-filled from the meta group column by node.py, hand-filled values win."
      },
      "sample_order": {
        "type": "list",
        "required": false,
        "default": [],
        "description": "Plotting order of samples; empty = meta order."
      },
      "formats": {
        "type": "list",
        "required": false,
        "default": ["png", "svg"],
        "description": "Output image formats (pyGenomeTracks --outFileName extensions)."
      },
      "gtf_track": {
        "type": "bool",
        "required": false,
        "default": true,
        "description": "Add a gene-model track at the bottom when the genome GTF exists."
      },
      "plot_height_per_track": {
        "type": "float",
        "required": false,
        "default": 1.5,
        "description": "Track height in inches per sample track."
      },
      "plot_width": {
        "type": "float",
        "required": false,
        "default": 12,
        "description": "Figure width in inches."
      }
    },
    "snv": {
      "enabled": {
        "type": "bool",
        "required": false
      }
    },
    "sv": {
      "enabled": {
        "type": "bool",
        "required": false
      },
      "comparisons": {
        "type": "dict",
        "required": false
      },
      "image_formats": {
        "type": "list",
        "required": false
      },
      "genes": {
        "type": "list",
        "required": false
      },
      "exp_specific": {
        "vep_cache": {
          "type": "str",
          "required": true,
          "path": "dir"
        },
        "species": {
          "type": "str",
          "required": true
        },
        "assembly": {
          "type": "str",
          "required": true
        },
        "dist": {
          "type": "int",
          "required": true
        }
      },
      "circos": {
        "genome": {
          "type": "str",
          "required": true
        },
        "cytoband": {
          "type": "str",
          "required": false
        },
        "ins_bin_size": {
          "type": "int",
          "required": true
        }
      },
      "oncoprint": {
        "cosmic_file": {
          "type": "str",
          "required": false,
          "path": "file"
        },
        "deseq2_files": {
          "type": "dict",
          "required": false
        }
      },
      "diff_analysis": {
        "large_sv_threshold": {
          "type": "int",
          "required": true
        }
      },
      "gene_model": {
        "threads": {
          "type": "int",
          "required": true
        }
      },
      "mei": {
        "type": "dict",
        "required": false,
        "properties": {
          "enabled": {
            "type": "bool",
            "required": false,
            "default": true,
            "description": "Gate the sv_mei analysis (MEI classification + figure suite)."
          },
          "min_len": {
            "type": "int",
            "required": false,
            "default": 100,
            "description": "Minimum inserted-sequence length (bp) sent to RepeatMasker; shorter events stay 'short_unclassified'."
          },
          "full_length": {
            "type": "int",
            "required": false,
            "default": 6000,
            "description": "Minimum insertion length (bp) for full-length candidacy."
          },
          "full_length_family": {
            "type": "str",
            "required": false,
            "default": "L1",
            "description": "Bucket name considered for full-length candidacy (L1 by default; e.g. an ERVK bucket for other clades)."
          },
          "te_buckets": {
            "type": "list|dict",
            "required": false,
            "default": {
              "GRCh38": [
                {"name": "Alu", "family": ["Alu"], "retro_fingerprint": true},
                {"name": "L1", "family": ["L1", "LINE"], "retro_fingerprint": true},
                {"name": "SVA", "family": ["SVA"], "retro_fingerprint": true},
                {"name": "LTR", "class": ["LTR"]},
                {"name": "DNA", "class": ["DNA"]},
                {"name": "microsatellite", "class": ["Simple_repeat"]},
                {"name": "other", "catch_all": "classified"},
                {"name": "unclassified", "catch_all": "unclassified"}
              ],
              "GRCm39": [
                {"name": "IAP/ETn", "family": ["ERVK"], "retro_fingerprint": true},
                {"name": "B1", "family": ["Alu"], "retro_fingerprint": true},
                {"name": "B2/ID", "family": ["tRNA", "B2"], "retro_fingerprint": true},
                {"name": "L1", "family": ["L1", "LINE"], "retro_fingerprint": true},
                {"name": "LTR", "class": ["LTR"]},
                {"name": "DNA", "class": ["DNA"]},
                {"name": "microsatellite", "class": ["Simple_repeat"]},
                {"name": "other", "catch_all": "classified"},
                {"name": "unclassified", "catch_all": "unclassified"}
              ],
              "T2T_mhaESC_v1.5": [
                {"name": "IAP/ETn", "family": ["ERVK"], "retro_fingerprint": true},
                {"name": "B1", "family": ["Alu"], "retro_fingerprint": true},
                {"name": "B2/ID", "family": ["tRNA", "B2"], "retro_fingerprint": true},
                {"name": "L1", "family": ["L1", "LINE"], "retro_fingerprint": true},
                {"name": "LTR", "class": ["LTR"]},
                {"name": "DNA", "class": ["DNA"]},
                {"name": "microsatellite", "class": ["Simple_repeat"]},
                {"name": "other", "catch_all": "classified"},
                {"name": "unclassified", "catch_all": "unclassified"}
              ],
              "Mmul_10": [
                {"name": "Alu", "family": ["Alu"], "retro_fingerprint": true},
                {"name": "L1", "family": ["L1", "LINE"], "retro_fingerprint": true},
                {"name": "SVA", "family": ["SVA"], "retro_fingerprint": true},
                {"name": "LTR", "class": ["LTR"]},
                {"name": "DNA", "class": ["DNA"]},
                {"name": "microsatellite", "class": ["Simple_repeat"]},
                {"name": "other", "catch_all": "classified"},
                {"name": "unclassified", "catch_all": "unclassified"}
              ],
              "Mmul_T2T": [
                {"name": "Alu", "family": ["Alu"], "retro_fingerprint": true},
                {"name": "L1", "family": ["L1", "LINE"], "retro_fingerprint": true},
                {"name": "SVA", "family": ["SVA"], "retro_fingerprint": true},
                {"name": "LTR", "class": ["LTR"]},
                {"name": "DNA", "class": ["DNA"]},
                {"name": "microsatellite", "class": ["Simple_repeat"]},
                {"name": "other", "catch_all": "classified"},
                {"name": "unclassified", "catch_all": "unclassified"}
              ]
            },
            "items": {
              "type": "dict",
              "properties": {
                "name": {"type": "str", "required": true, "description": "Bucket display name; never used for matching."},
                "subfamily": {"type": "list", "required": false, "description": "Exact (case-insensitive) match against the RM repeat NAME (AluY / B1_Mm / IAP1 ...)."},
                "family": {"type": "list", "required": false, "description": "Exact match against the RM class/family suffix (SINE/Alu -> Alu; no-slash entries match whole string)."},
                "class": {"type": "list", "required": false, "description": "Exact match against the RM class/family prefix (SINE, LTR, DNA ...). Only the FIRST non-empty of subfamily/family/class participates (probe order subfamily -> family -> class)."},
                "catch_all": {"type": "str", "required": false, "enum": ["classified", "unclassified"], "description": "classified: RM hit but no bucket matched; unclassified: no RM hit at all."},
                "retro_fingerprint": {"type": "bool", "required": false, "description": "true -> this bucket gets TSD detection (needs reference flanks) and is included in the retrotransposon fingerprint figure (polyA/TSD rates). Mark only active retrotransposon families (primate Alu/L1/SVA; mouse IAP/ETn, B1, B2/ID, L1)."},
                "zero_slot": {"type": "bool", "required": false, "default": true, "description": "false -> omit this bucket from figures when it has zero events (default true keeps the slot labelled 0)."}
              }
            },
            "description": "Per-species ordered TE bucket lists keyed by genome reference key (like genome.references; different species get different default vocabularies). A plain bucket list is also accepted and applies as-is. node.py resolves the active genome's list into raw.json. Bucket dict keys: name, subfamily, family, class, catch_all, retro_fingerprint, zero_slot; matching schema in modules/sv/bin/mei_analysis.py."
          }
        }
      }
    },
    "phase": {
      "enabled": {
        "type": "bool",
        "required": false
      }
    },
    "repeat": {
      "enabled": {
        "type": "bool",
        "required": false
      }
    },
    "telomere": {
      "enabled": {
        "type": "bool",
        "required": false
      }
    },
    "snv_caller": {
      "type": "str",
      "required": true
    },
    "deepvariant": {
      "model_type": {
        "type": "str",
        "required": true
      }
    },
    "trgt": {
      "karyotype": {
        "type": "str",
        "required": true
      },
      "repeat_id": {
        "type": "str",
        "required": true
      },
      "enabled": {
        "type": "bool",
        "required": false
      }
    },
    "telogator2": {
      "threads": {
        "type": "int",
        "required": true
      }
    },
    "hifiasm": {
      "threads": {
        "type": "int",
        "required": true
      }
    },
    "RepeatMasker": {
      "species": {
        "type": "str",
        "required": true
      },
      "threads": {
        "type": "int",
        "required": true
      },
      "dfam_h5": {
        "type": "str",
        "required": true,
        "path": "file"
      }
    },
    "decoil": {
      "enabled": {
        "type": "bool",
        "required": false
      },
      "reconstruct": {
        "type": "dict",
        "required": true,
        "additionalProperties": {
          "type": "dict",
          "properties": {
            "min_sv_len": {
              "type": "int",
              "required": true
            },
            "fragment_min_cov": {
              "type": "int",
              "required": true
            },
            "fragment_max_cov": {
              "type": "int",
              "required": true
            },
            "fragment_min_size": {
              "type": "int",
              "required": true
            },
            "min_vaf": {
              "type": "float",
              "required": true
            },
            "min_cov_alt": {
              "type": "int",
              "required": true
            },
            "min_cov": {
              "type": "int",
              "required": true
            },
            "max_explog_threshold": {
              "type": "float",
              "required": true
            },
            "filter_score": {
              "type": "int",
              "required": true
            },
            "sv_caller": {
              "type": "str",
              "required": true
            },
            "threads": {
              "type": "int",
              "required": true
            },
            "extend_allowed_chromosomes": {
              "type": "str",
              "required": false
            },
            "skip": {
              "type": "bool",
              "required": false
            }
          }
        }
      },
      "plot": {
        "type": "dict",
        "required": false,
        "properties": {
          "formats": {
            "type": "list",
            "required": false
          }
        }
      },
      "compare": {
        "type": "dict",
        "required": false,
        "properties": {
          "formats": {
            "type": "list",
            "required": false
          }
        }
      },
      "igv": {
        "type": "dict",
        "required": false,
        "properties": {
          "locus": {
            "type": "str",
            "required": false
          }
        }
      },
      "structure": {
        "type": "dict",
        "required": false,
        "properties": {
          "formats": {
            "type": "list",
            "required": false
          },
          "max_per_fig": {
            "type": "int",
            "required": false
          },
          "one_file_per_cycle": {
            "type": "bool",
            "required": false
          }
        }
      }
    },
    "gatk": {
      "javaOptions": {
        "type": "str",
        "required": true
      },
      "tmp-dir": {
        "type": "null",
        "nullable": true,
        "required": false
      },
      "addReadsGroup": {
        "RGLB": {
          "type": "str",
          "required": true
        },
        "RGPL": {
          "type": "str",
          "required": true
        },
        "RGPU": {
          "type": "str",
          "required": true
        }
      }
    }
  },
  "genome": {
    "default": {
      "type": "str",
      "required": true
    },
    "references": {
      "type": "dict",
      "required": true
    }
  },
  "container": {
    "type": "dict",
    "required": false
  },
  "env": {
    "type": "dict",
    "required": false
  },
  "raw_files": {
    "type": "list",
    "required": false
  }
}
