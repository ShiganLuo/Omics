        "type": "str",
        "required": true
      },
      "name": {
        "type": "str",
        "required": true
      },
      "publicPathMap": {
        "/home/luosg/Data/genomeStability/": {
          "type": "str",
          "required": false
        },
        "/home/luosg/Database/Reference/": {
          "type": "str",
          "required": false
        }
      },
      "fastaURL": {
        "type": "str",
        "required": true,
        "path": "file"
      },
      "indexURL": {
        "type": "str",
        "required": true,
        "path": "file"
      },
      "cytobandURL": {
        "type": "str",
        "required": true,
        "path": "file"
      },
      "tracks": {
        "type": "list",
        "required": true
      }
    }
  },
  "genome": {
    "default": {
      "type": "str",
      "required": true
    },
    "references": {
      "type": "dict",
      "required": true
    }
  },
  "env": {
    "type": "dict",
    "required": false
  },
  "raw_files": {
    "type": "list",
    "required": false
  }
}
