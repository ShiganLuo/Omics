        "n_neighbors": {"type": "int", "required": false},
        "resolution": {"type": "float", "required": false},
        "method": {"type": "str", "required": false},
        "batch_key": {"type": "str", "required": false}
      },
      "annotate": {
        "marker_file": {"type": "str", "required": false},
        "celltypist_model": {"type": "str", "required": false},
        "llm_method": {"type": "str", "required": false},
        "llm_model": {"type": "str", "required": false},
        "llm_api_key": {"type": "str", "required": false},
        "llm_base_url": {"type": "str", "required": false},
        "llm_top_genes": {"type": "int", "required": false},
        "annotate_group": {"type": "str", "required": false}
