      "advanced": {
        "trajectory": {"type": "bool", "required": false},
        "velocity": {"type": "bool", "required": false},
        "communication": {"type": "bool", "required": false},
        "cnv": {"type": "bool", "required": false},
        "gtf": {"type": "str", "required": false},
        "cnv_reference": {"type": "str", "required": false}
      }
