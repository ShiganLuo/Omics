    "type": "null",
    "nullable": true,
    "required": false
  },
  "env": {
    "type": "dict",
    "required": false,
    "properties": {
      "env_dir": {"type": "str", "nullable": true, "required": false},
      "scTE": {"type": "str", "nullable": true, "required": false},
      "cellranger": {"type": "str", "nullable": true, "required": false}
    }
  },
  "indir": {
    "type": "null",
    "nullable": true,
    "required": false
  },
  "raw_files": {
    "type": "list",
    "required": true
  },
  "outdir": {
    "type": "null",
    "nullable": true,
    "required": false
  },
  "logdir": {
    "type": "null",
    "nullable": true,
    "required": false
  },
  "paired_samples": {
    "type": "list",
    "required": true
  },
  "single_samples": {
    "type": "list",
    "required": true
  },
  "cellranger_input_dict": {
    "type": "dict",
    "required": false
