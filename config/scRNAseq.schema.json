  "genome": {
    "type": "object",
    "required": true,
    "properties": {
      "default": {
        "type": "str",
        "nullable": false,
        "required": true
      },
      "references": {
        "type": "object",
        "required": true,
        "additionalProperties": {
          "type": "object",
          "properties": {
            "fasta": {
              "type": "str",
              "nullable": true,
              "required": false,
              "path": "file"
            },
            "gtf": {
              "type": "str",
              "nullable": true,
              "required": false,
              "path": "file"
            },
            "te_bed": {
              "type": "str",
              "nullable": true,
              "required": false,
              "path": "file"
            },
            "scTE_index": {
              "type": "str",
              "nullable": true,
              "required": false,
              "path": "file"
            },
            "cellranger_ref_dir": {
              "type": "str",
              "nullable": true,
              "required": false,
              "path": "dir"
            }
          }
        }
      },
      "scTE_index": {
        "type": "str",
        "nullable": true,
        "required": false,
        "path": "file"
      }
    }
  },
  "Params": {
    "star": {
      "outSAMattributes": {
        "type": "str",
        "required": true
      },
      "outFilterMultimapNmax": {
        "type": "int",
        "required": true
      },
      "winAnchorMultimapNmax": {
        "type": "int",
        "required": true
      },
      "outMultimapperOrder": {
        "type": "str",
        "required": true
