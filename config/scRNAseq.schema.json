          "type": "bool",
          "required": true
        },
        "create-bam": {
          "type": "bool",
          "required": true
        }
      }
    },
    "scTE": {
      "genome": {
        "type": "str",
        "required": true
      },
      "mode": {
        "type": "str",
        "required": true
      },
      "cb_tag": {
        "type": "str",
        "required": true
      },
      "umi_tag": {
        "type": "str",
        "required": true
      },
      "gene_gtf": {
        "type": "null",
        "nullable": true,
        "required": false,
        "path": "file"
      },
      "te_bed": {
        "type": "null",
        "nullable": true,
        "required": false,
        "path": "file"
      }
    }
