# Auto-generated Apptainer definition file for TEfigs conda environment
# Source YAML: TEfigs.yaml
# Build: apptainer build TEfigs.sif TEfigs.def
# Or:   apptainer build <output.sif> <def_file>
# Backend: micromamba
# Install mode: explicit spec TEfigs.spec.txt

Bootstrap: docker
From: docker.1ms.run/mambaorg/micromamba:latest

%files
    TEfigs.spec.txt /opt/conda/TEfigs.spec.txt

%post
    /bin/bash << 'ENDOFSCRIPT'
    set -euo pipefail
    export MAMBA_ROOT_PREFIX="/opt/conda"
    micromamba create -y -p /opt/conda/envs/TEfigs -f /opt/conda/TEfigs.spec.txt < /dev/null
    micromamba clean -afy
    rm /opt/conda/TEfigs.spec.txt
    /opt/conda/envs/TEfigs/bin/python -m pip install -i https://pypi.tuna.tsinghua.edu.cn/simple TElocal==1.1.1

    echo 'export PATH="/opt/conda/envs/TEfigs/bin:$PATH"' >> /etc/profile.d/conda_TEfigs.sh
    echo 'export CONDA_DEFAULT_ENV=TEfigs' >> /etc/profile.d/conda_TEfigs.sh
ENDOFSCRIPT

%environment
    export PATH="/opt/conda/envs/TEfigs/bin:$PATH"
    export CONDA_DEFAULT_ENV=TEfigs

%runscript
    exec "$@"

%labels
    Author genomestability
    EnvName TEfigs

%help
    Apptainer image for conda environment 'TEfigs'.
    Generated from TEfigs.yaml.
