# Auto-generated Apptainer definition file for tefig conda environment
# Source YAML: tefig.yaml
# Build: apptainer build tefig.sif tefig.def
# Or:   apptainer build <output.sif> <def_file>
# Backend: micromamba
# Install mode: explicit spec tefig.spec.txt

Bootstrap: docker
From: docker.1ms.run/mambaorg/micromamba:latest

%files
    tefig.spec.txt /opt/conda/tefig.spec.txt

%post
    /bin/bash << 'ENDOFSCRIPT'
    set -euo pipefail
    export MAMBA_ROOT_PREFIX="/opt/conda"
    micromamba create -y -p /opt/conda/envs/tefig -f /opt/conda/tefig.spec.txt < /dev/null
    micromamba clean -afy
    rm /opt/conda/tefig.spec.txt
    /opt/conda/envs/tefig/bin/python -m pip install -i https://pypi.tuna.tsinghua.edu.cn/simple TElocal==1.1.1

    echo 'export PATH="/opt/conda/envs/tefig/bin:$PATH"' >> /etc/profile.d/conda_tefig.sh
    echo 'export CONDA_DEFAULT_ENV=tefig' >> /etc/profile.d/conda_tefig.sh
ENDOFSCRIPT

%environment
    export PATH="/opt/conda/envs/tefig/bin:$PATH"
    export CONDA_DEFAULT_ENV=tefig

%runscript
    exec "$@"

%labels
    Author genomestability
    EnvName tefig

%help
    Apptainer image for conda environment 'tefig'.
    Generated from tefig.yaml.
