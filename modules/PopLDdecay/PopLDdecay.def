# Auto-generated Apptainer definition file for PopLDdecay_population conda environment
# Source YAML: PopLDdecay_population.yaml
# Build: apptainer build PopLDdecay_population.sif PopLDdecay.def
# Or:   apptainer build <output.sif> <def_file>

Bootstrap: docker
From: docker.m.daocloud.io/continuumio/miniconda3:latest

%files
    PopLDdecay_population.yaml /opt/conda/PopLDdecay_population.yaml

%post
    conda env create -f /opt/conda/PopLDdecay_population.yaml && \
        conda clean -afy && \
        rm /opt/conda/PopLDdecay_population.yaml

    echo 'export PATH="/opt/conda/envs/PopLDdecay_population/bin:$PATH"' >> /etc/profile.d/conda_PopLDdecay_population.sh
    echo 'export CONDA_DEFAULT_ENV=PopLDdecay_population' >> /etc/profile.d/conda_PopLDdecay_population.sh

%environment
    export PATH="/opt/conda/envs/PopLDdecay_population/bin:$PATH"
    export CONDA_DEFAULT_ENV=PopLDdecay_population

%runscript
    exec "$@"

%labels
    Author genomestability
    EnvName PopLDdecay_population

%help
    Apptainer image for conda environment 'PopLDdecay_population'.
    Generated from PopLDdecay_population.yaml.
