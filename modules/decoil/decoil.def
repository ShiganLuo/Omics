# Auto-generated Apptainer definition file for decoil (PyPI/uv)
# Source YAML: decoil.yaml
# Build: apptainer build decoil.sif decoil.def
# Or:   apptainer build <output.sif> <def_file>
# Backend: uv

Bootstrap: docker
From: ghcr.io/astral-sh/uv:python3.9-trixie-slim

%post
    /bin/bash << 'ENDOFSCRIPT'
    set -euo pipefail
    apt-get update
    apt-get install -y --no-install-recommends build-essential zlib1g-dev libbz2-dev liblzma-dev
    rm -rf /var/lib/apt/lists/*
    pip install --no-cache-dir "decoil==2.0.2"
ENDOFSCRIPT

%environment
    export PATH="/usr/local/bin:$PATH"

%runscript
    exec "$@"

%labels
    Author genomestability
    EnvName decoil

%help
    Apptainer image for decoil (PyPI: "decoil==2.0.2").
    Built with uv venv (python 3.9).
