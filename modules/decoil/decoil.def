# Auto-generated Apptainer definition file for decoil conda environment
# Source YAML: decoil.yaml
# Build: apptainer build decoil.sif decoil.def
# Or:   apptainer build <output.sif> <def_file>
# Backend: micromamba

Bootstrap: docker
From: dockerproxy.net/mambaorg/micromamba:latest

%files
    decoil.yaml /opt/conda/decoil.yaml

%post
    /bin/bash << 'ENDOFSCRIPT'
    set -euo pipefail
    export MAMBA_ROOT_PREFIX="/opt/conda"
    micromamba env create -f /opt/conda/decoil.yaml < /dev/null && \
        micromamba clean -afy && \
        rm /opt/conda/decoil.yaml

    echo 'export PATH="/opt/conda/envs/decoil/bin:$PATH"' >> /etc/profile.d/conda_decoil.sh
    echo 'export CONDA_DEFAULT_ENV=decoil' >> /etc/profile.d/conda_decoil.sh
ENDOFSCRIPT

%environment
    export PATH="/opt/conda/envs/decoil/bin:$PATH"
    export CONDA_DEFAULT_ENV=decoil

%runscript
    exec "$@"

%labels
    Author genomestability
    EnvName decoil

%help
    Apptainer image for conda environment 'decoil'.
    Generated from decoil.yaml.
