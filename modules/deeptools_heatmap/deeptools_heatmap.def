# Auto-generated Apptainer definition file for deeptools_heatmap (PyPI/uv)
# Source YAML: deeptools_heatmap.yaml
# Build: apptainer build deeptools_heatmap.sif deeptools_heatmap.def
# Or:   apptainer build <output.sif> <def_file>

Bootstrap: docker
From: docker.m.daocloud.io/python:3.11-slim

%post
    set -euo pipefail
    apt-get update && apt-get install -y --no-install-recommends build-essential zlib1g-dev libbz2-dev liblzma-dev && \
        rm -rf /var/lib/apt/lists/*
    pip install --no-cache-dir uv && \
        uv pip install --system --no-cache-dir "deeptools>=3.5.6" "matplotlib>=3.7" "numpy>=2.0"

%environment
    export PATH="/usr/local/bin:$PATH"

%runscript
    exec "$@"

%labels
    Author genomestability
    EnvName deeptools_heatmap

%help
    Apptainer image for deeptools_heatmap (PyPI: "deeptools>=3.5.6" "matplotlib>=3.7" "numpy>=2.0").
    Built with uv.
