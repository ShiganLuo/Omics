# Auto-generated Apptainer definition file for exomePeak conda environment
# Source YAML: exomePeak.yaml
# Build: apptainer build exomePeak.sif exomePeak.def
# Or:   apptainer build <output.sif> <def_file>

Bootstrap: docker
From: docker.m.daocloud.io/continuumio/miniconda3:latest

%files
    exomePeak.yaml /opt/conda/exomePeak.yaml

%post
    conda env create -f /opt/conda/exomePeak.yaml && \
        conda clean -afy && \
        rm /opt/conda/exomePeak.yaml

    echo 'export PATH="/opt/conda/envs/exomePeak/bin:$PATH"' >> /etc/profile.d/conda_exomePeak.sh
    echo 'export CONDA_DEFAULT_ENV=exomePeak' >> /etc/profile.d/conda_exomePeak.sh

%environment
    export PATH="/opt/conda/envs/exomePeak/bin:$PATH"
    export CONDA_DEFAULT_ENV=exomePeak

%runscript
    exec "$@"

%labels
    Author genomestability
    EnvName exomePeak

%help
    Apptainer image for conda environment 'exomePeak'.
    Generated from exomePeak.yaml.
