{
  "indir": {
    "type": "str",
    "nullable": true,
    "required": true,
    "description": "elements dir (common/4_elements); per-sample paths splice {indir}/{sample}/{sample}{suffix}"
  },
  "outdir": {
    "type": "str",
    "nullable": true,
    "required": true
  },
  "logdir": {
    "type": "str",
    "nullable": true,
    "required": true
  },
  "ROOT_DIR": {
    "type": "str",
    "nullable": true,
    "required": false
  },
  "samples": {
    "type": "list",
    "nullable": true,
    "required": true,
    "default": [],
    "description": "sample ids; their order is the default --sample-order (reference first)"
  },
  "regions_bed": {
    "type": "str",
    "path": "file",
    "nullable": true,
    "required": true,
    "description": "regions BED (>=4 cols, col4 = region name); region names drive the per-region outputs"
  },
  "settings": {
    "type": "list",
    "nullable": true,
    "required": false,
    "default": [],
    "description": "setting labels = the {setting} wildcard values (one engine run each); default ['auto'] runs once with k=auto; sensitivity presets: list labels + per-label overrides in channel_by_setting/k_by_setting"
  },
  "Params": {
    "type": "dict",
    "nullable": true,
    "required": false,
    "properties": {
      "fibercluster": {
        "type": "dict",
        "nullable": true,
        "required": false,
        "properties": {
          "fiber_cluster": {
            "type": "dict",
            "nullable": true,
            "required": false,
            "properties": {
              "msp_suffix": {
                "type": "str",
                "nullable": true,
                "required": false,
                "default": ".msp.bed.gz",
                "description": "MSP element BED suffix under {indir}/{sample}/"
              },
              "nuc_suffix": {
                "type": "str",
                "nullable": true,
                "required": false,
                "default": ".nuc.bed.gz",
                "description": "nuc element BED suffix; null disables the nucleosome overlay"
              },
              "fire_suffix": {
                "type": "str",
                "nullable": true,
                "required": false,
                "default": ".fire_peaks.bed",
                "description": "FIRE peaks BED suffix; null disables the FIRE overlay/channel"
              },
              "channel": {
                "type": "str",
                "nullable": true,
                "required": false,
                "default": "msp",
                "description": "clustering channel msp|fire (-C); default msp"
              },
              "k": {
                "type": "int",
                "nullable": true,
                "required": false,
                "default": 0,
                "description": "cluster count (-k); 0 = auto per region (Hamming silhouette + min-cluster guard, writes k_selection.tsv)"
              },
              "channel_by_setting": {
                "type": "dict",
                "nullable": true,
                "required": false,
                "default": {},
                "description": "optional per-setting channel override msp|fire; labels without an entry fall back to Params.fibercluster.fiber_cluster.channel"
              },
              "k_by_setting": {
                "type": "dict",
                "nullable": true,
                "required": false,
                "default": {},
                "description": "optional per-setting cluster count override; labels without an entry fall back to Params.fibercluster.fiber_cluster.k (0 = auto)"
              },
              "method": {
                "type": "str",
                "nullable": true,
                "required": false,
                "default": "hierarchical",
                "description": "clustering method hierarchical|kmeans (-e)"
              },
              "min_fibers": {
                "type": "int",
                "nullable": true,
                "required": false,
                "default": 10,
                "description": "per-region minimum spanning fibers (-n)"
              },
              "min_span_frac": {
                "type": "float",
                "nullable": true,
                "required": false,
                "default": 0.8,
                "description": "fiber must span this fraction of the region (-s)"
              },
              "max_fibers": {
                "type": "int",
                "nullable": true,
                "required": false,
                "default": 300,
                "description": "display subsample cap per figure (-a)"
              },
              "right_tracks": {
                "type": "str",
                "nullable": true,
                "required": false,
                "default": "fire,lnk,nuc",
                "description": "right coverage-track layers, comma list or none (-T)"
              },
              "cache_dir": {
                "type": "str",
                "nullable": true,
                "required": false,
                "default": "",
                "description": "extraction cache dir (-y); empty = no cache (tabix jump still applies)"
              }
            }
          },
          "fiber_report": {
            "type": "dict",
            "nullable": true,
            "required": false,
            "properties": {
              "canonical": {
                "type": "str",
                "nullable": true,
                "required": false,
                "default": "",
                "description": "setting label whose figures/summary become the deliverable (-c); default = first setting label"
              }
            }
          }
        }
      }
    }
  }
}