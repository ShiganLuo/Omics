# Auto-generated Apptainer definition file for fiberseq conda environment
# Source YAML: fiberseq.yaml
# Build: apptainer build fiberseq.sif fiberseq.def
# Or:   apptainer build <output.sif> <def_file>
# Backend: micromamba

Bootstrap: docker
From: docker.1ms.run/mambaorg/micromamba:latest

%files
    fiberseq.yaml /opt/conda/fiberseq.yaml

%post
    /bin/bash << 'ENDOFSCRIPT'
    set -euo pipefail
    export MAMBA_ROOT_PREFIX="/opt/conda"
    micromamba env create -f /opt/conda/fiberseq.yaml < /dev/null && \
        micromamba clean -afy && \
        rm /opt/conda/fiberseq.yaml

    echo 'export PATH="/opt/conda/envs/fiberseq/bin:$PATH"' >> /etc/profile.d/conda_fiberseq.sh
    echo 'export CONDA_DEFAULT_ENV=fiberseq' >> /etc/profile.d/conda_fiberseq.sh
ENDOFSCRIPT

%environment
    export PATH="/opt/conda/envs/fiberseq/bin:$PATH"
    export CONDA_DEFAULT_ENV=fiberseq

%runscript
    exec "$@"

%labels
    Author genomestability
    EnvName fiberseq

%help
    Apptainer image for conda environment 'fiberseq'.
    Generated from fiberseq.yaml.
