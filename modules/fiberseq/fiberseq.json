{
  "indir": "common/4_elements",
  "outdir": "fiberseq_analysis",
  "logdir": "log",
  "samples": [],
  "Procedure": {},
  "Params": {
    "fiberseq_annotate": {
      "fiberseq_annotate_run": {
        "tss_flank": 1000,
        "repeat_frac": 0.25
      }
    },
    "fiberseq_motif": {
      "fiberseq_motif_profile": {
        "formats": [
          "pdf"
        ],
        "flank": 250,
        "min_fibers": 10
      },
      "fiberseq_motif_result": {
        "formats": [
          "pdf"
        ]
      },
      "fiberseq_motif_scan": {
        "pwm_threshold": 0.8
      }
    },
    "fiberseq_footprint": {
      "fiberseq_footprint_run": {
        "formats": [
          "pdf"
        ],
        "flank": 1000
      },
      "fiberseq_footprint_result": {
        "formats": [
          "pdf"
        ]
      }
    },
    "fiberseq_nucpos": {
      "fiberseq_nucpos_run": {
        "formats": [
          "pdf"
        ],
        "upstream_nucs": 5,
        "downstream_nucs": 5,
        "min_fibers": 10
      },
      "fiberseq_nucpos_result": {
        "formats": [
          "pdf"
        ]
      }
    },
    "fiberseq_quant": {},
    "fiberseq_diff": {
      "fiberseq_diff_run": {
        "formats": [
          "pdf"
        ],
        "alpha": 0.05,
        "annot_sample": null
      }
    },
    "fiberseq_coactuation": {
      "fiberseq_coactuation_run": {
        "max_distance": 50000,
        "min_fibers": 10,
        "max_pairs": 200000,
        "alpha": 0.05
      }
    },
    "fiberseq_haplotype": {
      "fiberseq_haplotype_diff": {
        "min_fibers": 10,
        "alpha": 0.05
      }
    },
    "fiberseq_censat": {
      "fiberseq_censat_run": {
        "formats": [
          "pdf"
        ],
        "msp_min_len": 50,
        "flank": 10000,
        "bin": 500
      },
      "fiberseq_censat_result": {
        "formats": [
          "pdf"
        ]
      }
    },
    "fiberseq_track": {
      "fiberseq_track_run": {
        "bin": 10
      }
    }
  },
  "genome": {
    "fasta": null,
    "fai": null,
    "gtf": null,
    "repeat_bed": null,
    "censat_bed": null,
    "motif_file": null,
    "mcpg_pileup": null
  },
  "env": {}
}
