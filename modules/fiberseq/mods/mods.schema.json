{
  "indir": {
    "type": "str",
    "nullable": true,
    "required": true
  },
  "outdir": {
    "type": "str",
    "nullable": true,
    "required": true
  },
  "logdir": {
    "type": "str",
    "nullable": true,
    "required": true
  },
  "samples": {
    "type": "list",
    "nullable": true,
    "required": false
  },
  "contrasts": {
    "type": "list",
    "nullable": true,
    "required": false
  },
  "Params": {
    "type": "dict",
    "nullable": true,
    "required": false,
    "properties": {
      "fiberseq_mods": {
        "type": "dict",
        "nullable": true,
        "required": false,
        "properties": {
          "mod_type": {
            "type": "str",
            "nullable": true,
            "required": false
          },
          "groups": {
            "type": "list",
            "nullable": true,
            "required": false
          },
          "region_axis": {
            "type": "dict",
            "nullable": true,
            "required": false,
            "default": {
              "default": "fire_peaks",
              "options": {
                "te": {
                  "min_fibers": 3,
                  "loci_top_n": 5
                },
                "fire_peaks": {
                  "metric": "m6a_per_fiber",
                  "top_n": 0
                }
              }
            },
            "description": "区域轴判别式对象 {default, options}(genome 同构):轴专属参数在对应 options 条目内",
            "default_prop": {
              "type": "str",
              "required": true
            },
            "options": {
              "type": "dict",
              "required": true
            }
          },
          "group_samples": {
            "type": "dict",
            "nullable": true,
            "required": false
          }
        }
      }
    }
  }
}