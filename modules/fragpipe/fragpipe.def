# Auto-generated Apptainer definition file for fragpipe conda environment
# Source YAML: fragpipe.yaml
# Build: apptainer build fragpipe.sif fragpipe.def
# Or:   apptainer build <output.sif> <def_file>
# Backend: micromamba
# Install mode: explicit spec fragpipe.spec.txt

Bootstrap: docker
From: docker.1ms.run/mambaorg/micromamba:latest

%files
    fragpipe.spec.txt /opt/conda/fragpipe.spec.txt

%post
    /bin/bash << 'ENDOFSCRIPT'
    set -euo pipefail
    export MAMBA_ROOT_PREFIX="/opt/conda"
    micromamba create -y -p /opt/conda/envs/fragpipe -f /opt/conda/fragpipe.spec.txt < /dev/null
    micromamba clean -afy
    rm /opt/conda/fragpipe.spec.txt

    echo 'export PATH="/opt/conda/envs/fragpipe/bin:$PATH"' >> /etc/profile.d/conda_fragpipe.sh
    echo 'export CONDA_DEFAULT_ENV=fragpipe' >> /etc/profile.d/conda_fragpipe.sh
ENDOFSCRIPT

%environment
    export PATH="/opt/conda/envs/fragpipe/bin:$PATH"
    export CONDA_DEFAULT_ENV=fragpipe

%runscript
    exec "$@"

%labels
    Author genomestability
    EnvName fragpipe

%help
    Apptainer image for conda environment 'fragpipe'.
    Generated from fragpipe.yaml.
