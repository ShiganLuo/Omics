{
  "indir": {
    "type": "str",
    "nullable": true,
    "required": false
  },
  "outdir": {
    "type": "str",
    "required": true
  },
  "logdir": {
    "type": "str",
    "nullable": true,
    "required": false
  },
  "ROOT_DIR": {
    "type": "str",
    "required": true
  },
