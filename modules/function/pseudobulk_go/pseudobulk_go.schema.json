        "lfc_cut": {
          "type": "float",
          "required": false
        },
        "p_cut": {
          "type": "float",
          "required": false
        },
        "top": {
          "type": "int",
          "required": false
        },
        "format": {
          "type": "enum",
          "values": ["png", "pdf", "svg"],
          "required": false
        }
      }
    }
  }
}
