{
  "indir": {
    "type": "str",
    "nullable": true,
    "required": false
  },
  "outdir": {
    "type": "str",
    "required": true
  },
  "logdir": {
    "type": "str",
    "nullable": true,
    "required": false
  },
  "ROOT_DIR": {
    "type": "str",
    "required": true
  },
  "Params": {
    "function": {
      "pseudobulk_go": {
        "root": {
          "type": "str",
          "nullable": true,
          "required": false
        },
        "modes": {
          "type": "enum",
          "values": ["all", "gene", "te"],
          "required": false
        },
        "species": {
          "type": "enum",
          "values": ["human", "mouse", "macaque"],
          "required": true
        },
        "lfc_cut": {
          "type": "float",
          "required": false
        },
        "p_cut": {
          "type": "float",
          "required": false
        },
        "top": {
          "type": "int",
          "required": false
        },
        "formats": {
          "type": "list",
          "nullable": true,
          "required": false,
          "description": "图片格式(多种同时输出);合法值: png pdf svg ps eps tif tiff jpg jpeg pgf raw rgba(matplotlib 全集;R 侧 ggsave 设备集)"
        },
        "format": {
          "type": "enum",
          "values": ["png", "pdf", "svg"],
          "required": false,
          "description": "兼容旧配置的单数键(单格式);优先使用 formats"
        }
      }
    }
  }
}
