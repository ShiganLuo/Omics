{
  "outdir": "output",
  "logdir": "logs",
  "samples": [
    "sample1",
    "sample2"
  ],
  "sample_bams": {
    "sample1": "path/to/sample1.bam",
    "sample2": "path/to/sample2.bam"
  },
  "Procedure": {
    "gatk": "gatk"
  },
  "Params": {
    "gatk": {
      "gatk_population_haplotype_caller": {
        "javaOptions": "-Xmx30g"
      },
      "gatk_population_joint_genotyping": {
        "javaOptions": "-Xmx30g"
      }
    }
  },
  "genome": {
    "genome1": {
      "fasta": "path/to/genome1.fa",
      "fai_index": "path/to/genome1.fa.fai",
      "dict_index": "path/to/genome1.dict",
      "interval": ""
    },
    "genome2": {
      "fasta": "path/to/genome2.fa",
      "fai_index": "path/to/genome2.fa.fai",
      "dict_index": "path/to/genome2.dict",
      "interval": ""
    }
  }
}
