{
  "indir": "input",
  "outdir": "output",
  "logdir": "log",
  "input_bam_substring": "",
  "Procedure": {
    "gatk": "gatk",
    "samtools": "samtools"
  },
  "Params": {
    "gatk": {
      "addReadsGroup": {
        "RGLB": "lib1",
        "RGPL": "illumina",
        "RGPU": "unit1",
        "javaOptions": "-Xmx30g"
      },
      "gatk_index": {
        "javaOptions": "-Xmx30g"
      },
      "MarkDuplicates": {
        "javaOptions": "-Xmx30g"
      }
    }
  },
  "genome": {
    "genome1": {
      "fasta": "path/to/genome1.fa"
    },
    "genome2": {
      "fasta": "path/to/genome2.fa"
    }
  },
  "logdir_combine": "logs"
}
