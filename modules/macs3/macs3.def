# Auto-generated Apptainer definition file for macs3 (PyPI/uv)
# Source YAML: macs3.yaml
# Build: apptainer build macs3.sif macs3.def
# Or:   apptainer build <output.sif> <def_file>

Bootstrap: docker
From: docker.m.daocloud.io/python:3.11-slim

%post
    set -euo pipefail
    apt-get update && apt-get install -y --no-install-recommends build-essential zlib1g-dev libbz2-dev liblzma-dev && \
        rm -rf /var/lib/apt/lists/*
    pip install --no-cache-dir uv && \
        uv pip install --system --no-cache-dir "macs3>=3.0.0" "matplotlib>=3.5.0"

%environment
    export PATH="/usr/local/bin:$PATH"

%runscript
    exec "$@"

%labels
    Author genomestability
    EnvName macs3

%help
    Apptainer image for macs3 (PyPI: "macs3>=3.0.0" "matplotlib>=3.5.0").
    Built with uv.
