# Auto-generated Apptainer definition file for proteininference conda environment
# Source YAML: proteininference.yaml
# Build: apptainer build proteininference.sif proteininference.def
# Or:   apptainer build <output.sif> <def_file>

Bootstrap: docker
From: docker.m.daocloud.io/continuumio/miniconda3:latest

%files
    proteininference.yaml /opt/conda/proteininference.yaml

%post
    conda env create -f /opt/conda/proteininference.yaml && \
        conda clean -afy && \
        rm /opt/conda/proteininference.yaml

    echo 'export PATH="/opt/conda/envs/proteininference/bin:$PATH"' >> /etc/profile.d/conda_proteininference.sh
    echo 'export CONDA_DEFAULT_ENV=proteininference' >> /etc/profile.d/conda_proteininference.sh

%environment
    export PATH="/opt/conda/envs/proteininference/bin:$PATH"
    export CONDA_DEFAULT_ENV=proteininference

%runscript
    exec "$@"

%labels
    Author genomestability
    EnvName proteininference

%help
    Apptainer image for conda environment 'proteininference'.
    Generated from proteininference.yaml.
