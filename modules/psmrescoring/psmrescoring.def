# Auto-generated Apptainer definition file for psmrescoring conda environment
# Source YAML: psmrescoring.yaml
# Build: apptainer build psmrescoring.sif psmrescoring.def
# Or:   apptainer build <output.sif> <def_file>

Bootstrap: docker
From: docker.m.daocloud.io/continuumio/miniconda3:latest

%files
    psmrescoring.yaml /opt/conda/psmrescoring.yaml

%post
    conda env create -f /opt/conda/psmrescoring.yaml && \
        conda clean -afy && \
        rm /opt/conda/psmrescoring.yaml

    echo 'export PATH="/opt/conda/envs/psmrescoring/bin:$PATH"' >> /etc/profile.d/conda_psmrescoring.sh
    echo 'export CONDA_DEFAULT_ENV=psmrescoring' >> /etc/profile.d/conda_psmrescoring.sh

%environment
    export PATH="/opt/conda/envs/psmrescoring/bin:$PATH"
    export CONDA_DEFAULT_ENV=psmrescoring

%runscript
    exec "$@"

%labels
    Author genomestability
    EnvName psmrescoring

%help
    Apptainer image for conda environment 'psmrescoring'.
    Generated from psmrescoring.yaml.
