# Auto-generated Apptainer definition file for scanpy conda environment
# Source YAML: scanpy.yaml
# Build: apptainer build scanpy.sif scanpy.def
# Or:   apptainer build <output.sif> <def_file>
# Backend: micromamba

Bootstrap: docker
From: docker.1ms.run/mambaorg/micromamba:latest

%files
    scanpy.yaml /opt/conda/scanpy.yaml

%post
    /bin/bash << 'ENDOFSCRIPT'
    set -euo pipefail
    export MAMBA_ROOT_PREFIX="/opt/conda"
    micromamba env create -f /opt/conda/scanpy.yaml && \
        micromamba clean -afy && \
        rm /opt/conda/scanpy.yaml

    echo 'export PATH="/opt/conda/envs/scanpy/bin:$PATH"' >> /etc/profile.d/conda_scanpy.sh
    echo 'export CONDA_DEFAULT_ENV=scanpy' >> /etc/profile.d/conda_scanpy.sh
    ENDOFSCRIPT

%environment
    export PATH="/opt/conda/envs/scanpy/bin:$PATH"
    export CONDA_DEFAULT_ENV=scanpy

%runscript
    exec "$@"

%labels
    Author genomestability
    EnvName scanpy

%help
    Apptainer image for conda environment 'scanpy'.
    Generated from scanpy.yaml.
