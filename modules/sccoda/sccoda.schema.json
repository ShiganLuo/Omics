{
    "indir": {
        "type": "str",
        "nullable": true,
        "required": true
    },
    "outdir": {
        "type": "str",
        "nullable": true,
        "required": true
    },
    "logdir": {
        "type": "str",
        "nullable": true,
        "required": true
    },
    "ROOT_DIR": {
        "type": "str",
        "path": "dir",
        "nullable": true,
        "required": false
    },
    "reannotate": {
        "type": "dict",
        "nullable": true,
        "required": false,
        "properties": {}
    },
    "Procedure": {
        "type": "dict",
        "nullable": true,
        "required": false,
        "properties": {
            "python": {
                "type": "str",
                "nullable": true,
                "required": false
            }
        }
    },
    "Params": {
        "type": "dict",
        "nullable": true,
        "required": false,
        "properties": {
            "sccoda": {
                "type": "dict",
                "nullable": true,
                "required": false,
                "properties": {
                    "tissue_samples": {
                        "type": "dict",
                        "nullable": true,
                        "required": false,
                        "properties": {}
                    },
                    "scTE": {
                        "type": "dict",
                        "nullable": true,
                        "required": false,
                        "properties": {
                            "sccoda_run": {
                                "type": "dict",
                                "nullable": true,
                                "required": false,
                                "properties": {
                                    "enabled": {
                                        "type": "bool",
                                        "nullable": true,
                                        "required": false
                                    },
                                    "ref_celltype": {
                                        "type": "str",
                                        "nullable": true,
                                        "required": false,
                                        "description": "'automatic' or an explicit cell-type name"
                                    },
                                    "formula": {
                                        "type": "str",
                                        "nullable": true,
                                        "required": false
                                    },
                                    "credible_threshold": {
                                        "type": "float",
                                        "nullable": true,
                                        "required": false
                                    },
                                    "num_samples": {
                                        "type": "int",
                                        "nullable": true,
                                        "required": false
                                    },
                                    "num_warmup": {
                                        "type": "int",
                                        "nullable": true,
                                        "required": false
                                    },
                                    "compare": {
                                        "type": "dict",
                                        "nullable": true,
                                        "required": false,
                                        "description": "JSON design {tissue: {contrast: entry}}; entry = DESeq2 group_pairs ({control_group_name, experimental_group_name, control_samples, experimental_samples}) or ordered 'groups' [{name, samples}] for a multi-group contrast (first group = base level, each later group vs base; stacked barplot shows one bar per group, samples of a group summed; DA-credible cell types carry ↑/↓ legend marks in group order). The contrast key names the outputs (da_sccoda_<contrast>_*). Empty = shared from Params.scanpy.<counter>.scanpy_pseudobulk.compare (bare-sample string entries, converted to single-sample group_pairs)",
                                        "properties": {}
                                    },
                                    "formats": {
                                        "type": "list",
                                        "nullable": true,
                                        "required": false,
                                        "description": "图片格式(多种同时输出);合法值: png pdf svg ps eps tif tiff jpg jpeg pgf raw rgba(matplotlib 全集;R 侧 ggsave 设备集)"
                                    }
                                }
                            }
                        }
                    },
                    "cellranger": {
                        "type": "dict",
                        "nullable": true,
                        "required": false,
                        "properties": {
                            "sccoda_run": {
                                "type": "dict",
                                "nullable": true,
                                "required": false,
                                "properties": {
                                    "enabled": {
                                        "type": "bool",
                                        "nullable": true,
                                        "required": false
                                    },
                                    "ref_celltype": {
                                        "type": "str",
                                        "nullable": true,
                                        "required": false,
                                        "description": "'automatic' or an explicit cell-type name"
                                    },
                                    "formula": {
                                        "type": "str",
                                        "nullable": true,
                                        "required": false
                                    },
                                    "credible_threshold": {
                                        "type": "float",
                                        "nullable": true,
                                        "required": false
                                    },
                                    "num_samples": {
                                        "type": "int",
                                        "nullable": true,
                                        "required": false
                                    },
                                    "num_warmup": {
                                        "type": "int",
                                        "nullable": true,
                                        "required": false
                                    },
                                    "compare": {
                                        "type": "dict",
                                        "nullable": true,
                                        "required": false,
                                        "description": "JSON design {tissue: {contrast: entry}}; entry = DESeq2 group_pairs ({control_group_name, experimental_group_name, control_samples, experimental_samples}) or ordered 'groups' [{name, samples}] for a multi-group contrast (first group = base level, each later group vs base; stacked barplot shows one bar per group, samples of a group summed; DA-credible cell types carry ↑/↓ legend marks in group order). The contrast key names the outputs (da_sccoda_<contrast>_*). Empty = shared from Params.scanpy.<counter>.scanpy_pseudobulk.compare (bare-sample string entries, converted to single-sample group_pairs)",
                                        "properties": {}
                                    },
                                    "formats": {
                                        "type": "list",
                                        "nullable": true,
                                        "required": false,
                                        "description": "图片格式(多种同时输出);合法值: png pdf svg ps eps tif tiff jpg jpeg pgf raw rgba(matplotlib 全集;R 侧 ggsave 设备集)"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
