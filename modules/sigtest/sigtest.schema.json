{
  "indir": {
    "type": "str",
    "nullable": true,
    "required": true
  },
  "outdir": {
    "type": "str",
    "nullable": true,
    "required": true
  },
  "logdir": {
    "type": "str",
    "nullable": true,
    "required": true
  },
  "ROOT_DIR": {
    "type": "str",
    "nullable": true,
    "required": false
  },
  "sigtest_table": {
    "type": "str",
    "path": "file",
    "nullable": true,
    "required": true
  },
  "contrasts": {
    "type": "list",
    "nullable": true,
    "required": false,
    "default": []
  },
  "Params": {
    "type": "dict",
    "nullable": true,
    "required": false,
    "properties": {
      "sigtest": {
        "type": "dict",
        "nullable": true,
        "required": false,
        "properties": {
          "feature_col": {
            "type": "str",
            "nullable": true,
            "required": false,
            "default": "feature",
            "description": "feature column in the long table (subfamily/family on the TE axis)"
          },
          "feature_col_by_contrast": {
            "type": "dict",
            "nullable": true,
            "required": false,
            "default": {},
            "description": "per-contrast feature column override (node.py fills it for TE levels)"
          },
          "te_levels": {
            "type": "list",
            "nullable": true,
            "required": false,
            "default": [
              "subfamily",
              "family"
            ],
            "description": "TE annotation levels to sigtest, one contrast per level (mods TE axis; long table carries all levels)"
          },
          "group_col": {
            "type": "str",
            "nullable": true,
            "required": false,
            "default": "group"
          },
          "value_col": {
            "type": "str",
            "nullable": true,
            "required": false,
            "default": "value"
          },
          "groups": {
            "type": "list",
            "nullable": true,
            "required": false,
            "default": []
          },
          "method": {
            "type": "str",
            "nullable": true,
            "required": false,
            "default": "auto"
          },
          "paired": {
            "type": "bool",
            "nullable": true,
            "required": false,
            "default": false
          },
          "alpha": {
            "type": "float",
            "nullable": true,
            "required": false,
            "default": 0.05
          },
          "correction": {
            "type": "str",
            "nullable": true,
            "required": false,
            "default": "none"
          },
          "ylabel": {
            "type": "str",
            "nullable": true,
            "required": false,
            "default": "value"
          },
          "legend": {
            "type": "list",
            "nullable": true,
            "required": false,
            "default": []
          },
          "annotate_ns": {
            "type": "bool",
            "nullable": true,
            "required": false,
            "default": false
          },
          "no_errorbars": {
            "type": "bool",
            "nullable": true,
            "required": false,
            "default": false
          },
          "plot": {
            "type": "dict",
            "nullable": true,
            "required": false,
            "default": {
              "formats": [
                "png"
              ],
              "ylabel": "value"
            },
            "properties": {
              "formats": {
                "type": "list",
                "nullable": true,
                "default": [
                  "png"
                ],
                "description": "图片格式(多种同时输出);[] = 不出图(吸收旧 no_plot)"
              },
              "ylabel": {
                "type": "str",
                "nullable": true,
                "default": "value",
                "description": "柱状图 y 轴标签"
              }
            }
          }
        }
      }
    }
  }
}