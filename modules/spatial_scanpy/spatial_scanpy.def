# Auto-generated Apptainer definition file for spatial_scanpy conda environment
# Source YAML: spatial_scanpy.yaml
# Build: apptainer build spatial_scanpy.sif spatial_scanpy.def
# Or:   apptainer build <output.sif> <def_file>

Bootstrap: docker
From: docker.m.daocloud.io/continuumio/miniconda3:latest

%files
    spatial_scanpy.yaml /opt/conda/spatial_scanpy.yaml

%post
    conda env create -f /opt/conda/spatial_scanpy.yaml && \
        conda clean -afy && \
        rm /opt/conda/spatial_scanpy.yaml

    echo 'export PATH="/opt/conda/envs/spatial_scanpy/bin:$PATH"' >> /etc/profile.d/conda_spatial_scanpy.sh
    echo 'export CONDA_DEFAULT_ENV=spatial_scanpy' >> /etc/profile.d/conda_spatial_scanpy.sh

%environment
    export PATH="/opt/conda/envs/spatial_scanpy/bin:$PATH"
    export CONDA_DEFAULT_ENV=spatial_scanpy

%runscript
    exec "$@"

%labels
    Author genomestability
    EnvName spatial_scanpy

%help
    Apptainer image for conda environment 'spatial_scanpy'.
    Generated from spatial_scanpy.yaml.
