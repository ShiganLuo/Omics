# Auto-generated Apptainer definition file for spectrum conda environment
# Source YAML: spectrum.yaml
# Build: apptainer build spectrum.sif spectrum.def
# Or:   apptainer build <output.sif> <def_file>
#
# NOTE: the previously delivered image is star.sif (built when this env was
# named "star"); it registers in workflow configs as env.spectrum -> star.sif.
# Rebuild as spectrum.sif and update config env maps when convenient.

Bootstrap: docker
From: docker.m.daocloud.io/continuumio/miniconda3:latest

%files
    spectrum.yaml /opt/conda/spectrum.yaml

%post
    conda env create -f /opt/conda/spectrum.yaml && \
        conda clean -afy && \
        rm /opt/conda/spectrum.yaml

    echo 'export PATH="/opt/conda/envs/spectrum/bin:$PATH"' >> /etc/profile.d/conda_spectrum.sh
    echo 'export CONDA_DEFAULT_ENV=spectrum' >> /etc/profile.d/conda_spectrum.sh

%environment
    export PATH="/opt/conda/envs/spectrum/bin:$PATH"
    export CONDA_DEFAULT_ENV=spectrum

%runscript
    exec "$@"

%labels
    Author genomestability
    EnvName spectrum

%help
    Apptainer image for conda environment 'spectrum'.
    Generated from spectrum.yaml.
